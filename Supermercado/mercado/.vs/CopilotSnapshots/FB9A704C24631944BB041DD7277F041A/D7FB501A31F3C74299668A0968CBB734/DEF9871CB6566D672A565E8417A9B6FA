    public partial class FormCaixa : Form
    {
        // Ajuste a connection string conforme seu ambiente
        private string connectionString = "Server=localhost;Database=mercadoleoisa;Uid=root;Pwd=";

        private DataTable dtItens;

        public FormCaixa()
        {
            InitializeComponent();
            Inicializar();
        }

        private void Inicializar()
        {
            dtItens = new DataTable();
            dtItens.Columns.Add("produto_id", typeof(int));
            dtItens.Columns.Add("codigo", typeof(string));
            dtItens.Columns.Add("descricao", typeof(string));
            // quantidade agora aceita decimais (kg) para pesagem
            dtItens.Columns.Add("quantidade", typeof(decimal));
            dtItens.Columns.Add("preco_unitario", typeof(decimal));
            dtItens.Columns.Add("subtotal", typeof(decimal));

            dgvItens.DataSource = dtItens;

            if (dgvItens.Columns["preco_unitario"] != null)
                dgvItens.Columns["preco_unitario"].DefaultCellStyle.Format = "N2";
            if (dgvItens.Columns["subtotal"] != null)
                dgvItens.Columns["subtotal"].DefaultCellStyle.Format = "N2";

            cbFormaPagamento.Items.Clear();
            cbFormaPagamento.Items.AddRange(new object[] { "Dinheiro", "Cartão Débito", "Cartão Crédito", "PIX", "Convênio" });
            cbFormaPagamento.SelectedIndex = 0;

            txtCpfConvenio.Enabled = false;
            txtSenhaConvenio.Enabled = false;
            txtSenhaConvenio.PasswordChar = '*';

            btnAdicionar.Click += btnAdicionar_Click;
            btnRemover.Click += btnRemover_Click;
            btnFinalizar.Click += btnFinalizar_Click;
            btnCancelar.Click += btnCancelar_Click;
            btnVoltar.Click += btnVoltar_Click;
            cbFormaPagamento.SelectedIndexChanged += CbFormaPagamento_SelectedIndexChanged;

            txtCodigo.KeyDown += TxtCodigo_KeyDown;
        }

        private void TxtCodigo_KeyDown(object sender, KeyEventArgs e)
        {
            if (e.KeyCode == Keys.Enter)
            {
                btnAdicionar.PerformClick();
                e.SuppressKeyPress = true;
            }
        }

        private void CbFormaPagamento_SelectedIndexChanged(object sender, EventArgs e)
        {
            bool convenio = cbFormaPagamento.SelectedItem?.ToString() == "Convênio";
            txtCpfConvenio.Enabled = convenio;
            txtSenhaConvenio.Enabled = convenio;

            if (convenio)
                txtCpfConvenio.Focus();
            else
                txtCodigo.Focus();
        }

        private void btnAdicionar_Click(object sender, EventArgs e)
        {
            lblStatus.Text = string.Empty;
            string codigo = txtCodigo.Text.Trim();
            if (string.IsNullOrEmpty(codigo))
            {
                lblStatus.Text = "Informe o código ou ID do produto.";
                return;
            }

            decimal quantidade;
            // Detecta quantidade decimal (aceita 0,650 ou 0.650)
            string qtdText = txtQuantidade.Text.Trim();
            if (!decimal.TryParse(qtdText.Replace(',', '.'), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out quantidade) || quantidade <= 0)
            {
                lblStatus.Text = "Quantidade inválida.";
                return;
            }

            try
            {
                using (var conn = new MySqlConnection(connectionString))
                using (var cmd = conn.CreateCommand())
                {
                    conn.Open();

                    // Verifica padrão de etiqueta de balança de 9 dígitos: PPPPWWWWW
                    // PPPP = código do produto (4 dígitos), WWWWW = peso em gramas (5 dígitos)
                    if (codigo.Length == 9 && codigo.All(char.IsDigit))
                    {
                        string partProd = codigo.Substring(0, 4);
                        string partPeso = codigo.Substring(4, 5);
                        // extrai código do produto sem zeros à esquerda
                        codigo = Convert.ToInt32(partProd).ToString();
                        // converte gramas para Kg decimal
                        if (int.TryParse(partPeso, out int gramas))
                        {
                            quantidade = gramas / 1000.0m;
                        }
                    }

                    cmd.CommandText = "SELECT id, COALESCE(codigo,'') AS codigo, COALESCE(nome,descricao) AS descricao, preco AS valor, quantidade FROM produtos WHERE id = @cod OR codigo = @cod OR nome LIKE @likeCod LIMIT 1";
                    cmd.Parameters.AddWithValue("@cod", codigo);
                    cmd.Parameters.AddWithValue("@likeCod", "%" + codigo + "%");

                    using (var reader = cmd.ExecuteReader())
                    {
                        if (!reader.Read())
                        {
                            lblStatus.Text = "Produto não encontrado.";
                            return;
                        }

                        int produtoId = reader.GetInt32("id");
                        string codigoProd = reader["codigo"].ToString();
                        string descricao = reader["descricao"].ToString();
                        decimal preco = reader.IsDBNull(reader.GetOrdinal("valor")) ? 0m : reader.GetDecimal("valor");
                        // quantidade em estoque pode ser inteiro ou decimal; use Convert.ToDecimal
                        decimal estoque = reader.IsDBNull(reader.GetOrdinal("quantidade")) ? 0m : Convert.ToDecimal(reader["quantidade"]);

                        if (estoque < quantidade)
                        {
                            lblStatus.Text = $"Estoque insuficiente (disponível: {estoque}).";
                            return;
                        }

                        var existente = dtItens.AsEnumerable().FirstOrDefault(r => r.Field<int>("produto_id") == produtoId);
                        if (existente != null)
                        {
                            decimal atual = existente.Field<decimal>("quantidade");
                            decimal novo = atual + quantidade;
                            if (novo > estoque)
                            {
                                lblStatus.Text = $"Estoque insuficiente para total solicitado (disponível: {estoque}).";
                                return;
                            }
                            existente.SetField("quantidade", novo);
                            existente.SetField("subtotal", Math.Round(preco * novo, 2));
                        }
                        else
                        {
                            var row = dtItens.NewRow();
                            row["produto_id"] = produtoId;
                            row["codigo"] = codigoProd;
                            row["descricao"] = descricao;
                            row["quantidade"] = quantidade;
                            row["preco_unitario"] = preco;
                            row["subtotal"] = Math.Round(preco * quantidade, 2);
                            dtItens.Rows.Add(row);
                        }

                        AtualizarTotal();
                        txtCodigo.Text = string.Empty;
                        txtQuantidade.Text = "1";
                        txtCodigo.Focus();
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Erro ao adicionar item: " + ex.Message, "Erro", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnRemover_Click(object sender, EventArgs e)
        {
            lblStatus.Text = string.Empty;
            if (dgvItens.CurrentRow == null)
            {
                lblStatus.Text = "Selecione um item para remover.";
                return;
            }

            try
            {
                int produtoId = Convert.ToInt32(dgvItens.CurrentRow.Cells["produto_id"].Value);
                var row = dtItens.AsEnumerable().FirstOrDefault(r => r.Field<int>("produto_id") == produtoId);
                if (row != null)
                {
                    dtItens.Rows.Remove(row);
                    AtualizarTotal();
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Erro ao remover item: " + ex.Message, "Erro", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void AtualizarTotal()
        {
            decimal total = 0m;
            foreach (DataRow r in dtItens.Rows)
                total += r.Field<decimal>("subtotal");

            lblTotal.Text = total.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));
        }

        private void btnCancelar_Click(object sender, EventArgs e)
        {
            if (MessageBox.Show("Cancelar venda atual?", "Confirmar", MessageBoxButtons.YesNo, MessageBoxIcon.Question) == DialogResult.Yes)
            {
                dtItens.Clear();
                AtualizarTotal();
                txtCodigo.Text = string.Empty;
                txtQuantidade.Text = "1";
                txtCpfConvenio.Text = string.Empty;
                txtSenhaConvenio.Text = string.Empty;
                lblStatus.Text = "Venda cancelada.";
            }
        }

        private void btnFinalizar_Click(object sender, EventArgs e)
        {
            lblStatus.Text = string.Empty;
            if (dtItens.Rows.Count == 0)
            {
                lblStatus.Text = "Nenhum item na venda.";
                return;
            }

            decimal total = dtItens.AsEnumerable().Sum(r => r.Field<decimal>("subtotal"));
            string forma = cbFormaPagamento.SelectedItem?.ToString() ?? "Dinheiro";
            string cpfConvenio = txtCpfConvenio.Text.Trim();

            // Validação para Convênio
            if (forma == "Convênio")
            {
                if (string.IsNullOrEmpty(cpfConvenio) || string.IsNullOrEmpty(txtSenhaConvenio.Text.Trim()))
                {
                    lblStatus.Text = "Informe CPF e senha do convênio.";
                    return;
                }

                try
                {
                    using (var conn = new MySqlConnection(connectionString))
                    using (var cmd = conn.CreateCommand())
                    {
                        conn.Open();
                        cmd.CommandText = "SELECT cpf, senha, ativo, limite_credito, saldo_devedor FROM clientes WHERE cpf = @cpf LIMIT 1";
                        cmd.Parameters.AddWithValue("@cpf", cpfConvenio);
                        using (var reader = cmd.ExecuteReader())
                        {
                            if (!reader.Read())
                            {
                                lblStatus.Text = "Cliente convênio não encontrado.";
                                return;
                            }
                            bool ativo = true;
                            if (!reader.IsDBNull(reader.GetOrdinal("ativo")))
                                ativo = reader.GetInt32("ativo") == 1;
                            if (!ativo)
                            {
                                lblStatus.Text = "Conta de convênio inativa.";
                                return;
                            }
                            string senhaDb = reader.IsDBNull(reader.GetOrdinal("senha")) ? string.Empty : reader.GetString("senha");
                            if (senhaDb != txtSenhaConvenio.Text.Trim())
                            {
                                lblStatus.Text = "Senha convênio inválida.";
                                return;
                            }
                            decimal limite = reader.IsDBNull(reader.GetOrdinal("limite_credito")) ? 0m : reader.GetDecimal("limite_credito");
                            decimal saldo = reader.IsDBNull(reader.GetOrdinal("saldo_devedor")) ? 0m : reader.GetDecimal("saldo_devedor");
                            if ((limite - saldo) < total)
                            {
                                lblStatus.Text = "Limite de convênio insuficiente.";
                                return;
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Erro ao validar convênio: " + ex.Message, "Erro", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }
            }

            // Transação para gravar venda
            try
            {
                using (var conn = new MySqlConnection(connectionString))
                {
                    conn.Open();
                    using (var trans = conn.BeginTransaction())
                    using (var cmd = conn.CreateCommand())
                    {
                        cmd.Transaction = trans;

                        // Inserir venda
                        cmd.CommandText = "INSERT INTO vendas (data_venda, total, forma_pagamento, cliente_cpf, operador) VALUES (NOW(), @total, @forma, @cpf, @operador)";
                        cmd.Parameters.Clear();
                        cmd.Parameters.AddWithValue("@total", total);
                        cmd.Parameters.AddWithValue("@forma", forma);
                        cmd.Parameters.AddWithValue("@cpf", string.IsNullOrEmpty(cpfConvenio) ? (object)DBNull.Value : cpfConvenio);
                        cmd.Parameters.AddWithValue("@operador", Environment.UserName ?? (object)DBNull.Value);
                        cmd.ExecuteNonQuery();

                        cmd.CommandText = "SELECT LAST_INSERT_ID()";
                        cmd.Parameters.Clear();
                        long vendaId = Convert.ToInt64(cmd.ExecuteScalar());

                        // Processa itens
                        foreach (DataRow r in dtItens.Rows)
                        {
                            int produtoId = r.Field<int>("produto_id");
                            int qtd = r.Field<int>("quantidade");
                            decimal preco = r.Field<decimal>("preco_unitario");
                            decimal subtotal = r.Field<decimal>("subtotal");

                            // Verifica estoque com lock
                            cmd.CommandText = "SELECT quantidade FROM produtos WHERE id = @pid FOR UPDATE";
                            cmd.Parameters.Clear();
                            cmd.Parameters.AddWithValue("@pid", produtoId);
                            object obj = cmd.ExecuteScalar();
                            if (obj == null)
                            {
                                trans.Rollback();
                                MessageBox.Show($"Produto id {produtoId} não encontrado durante finalização.", "Erro", MessageBoxButtons.OK, MessageBoxIcon.Error);
                                return;
                            }
                            int estoqueAtual = Convert.ToInt32(obj);
                            if (estoqueAtual < qtd)
                            {
                                trans.Rollback();
                                MessageBox.Show($"Estoque insuficiente para produto id {produtoId} (disponível {estoqueAtual}).", "Erro", MessageBoxButtons.OK, MessageBoxIcon.Error);
                                return;
                            }

                            // inserir item
                            cmd.CommandText = "INSERT INTO itens_venda (venda_id, produto_id, quantidade, preco_unitario, subtotal) VALUES (@venda, @produto, @qtd, @preco, @sub)";
                            cmd.Parameters.Clear();
                            cmd.Parameters.AddWithValue("@venda", vendaId);
                            cmd.Parameters.AddWithValue("@produto", produtoId);
                            cmd.Parameters.AddWithValue("@qtd", qtd);
                            cmd.Parameters.AddWithValue("@preco", preco);
                            cmd.Parameters.AddWithValue("@sub", subtotal);
                            cmd.ExecuteNonQuery();

                            // atualizar estoque
                            cmd.CommandText = "UPDATE produtos SET quantidade = quantidade - @qtd WHERE id = @produto";
                            cmd.Parameters.Clear();
                            cmd.Parameters.AddWithValue("@qtd", qtd);
                            cmd.Parameters.AddWithValue("@produto", produtoId);
                            cmd.ExecuteNonQuery();
                        }

                        // Atualiza saldo do convênio se aplicável
                        if (forma == "Convênio" && !string.IsNullOrEmpty(cpfConvenio))
                        {
                            cmd.CommandText = "UPDATE clientes SET saldo_devedor = saldo_devedor + @valor WHERE cpf = @cpf";
                            cmd.Parameters.Clear();
                            cmd.Parameters.AddWithValue("@valor", total);
                            cmd.Parameters.AddWithValue("@cpf", cpfConvenio);
                            cmd.ExecuteNonQuery();
                        }

                        trans.Commit();

                        // Gera CSV e abre no Excel
                        GerarCupomCsv(vendaId, total, forma);

                        MessageBox.Show("Venda finalizada com sucesso.", "Sucesso", MessageBoxButtons.OK, MessageBoxIcon.Information);

                        // Limpa
                        dtItens.Clear();
                        AtualizarTotal();
                        txtCodigo.Text = string.Empty;
                        txtQuantidade.Text = "1";
                        txtCpfConvenio.Text = string.Empty;
                        txtSenhaConvenio.Text = string.Empty;
                        cbFormaPagamento.SelectedIndex = 0;
                        txtCodigo.Focus();
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Erro ao finalizar venda: " + ex.Message, "Erro", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void GerarCupomCsv(long vendaId, decimal total, string forma)
        {
            try
            {
                var sb = new StringBuilder();
                sb.AppendLine("Loja;Supermercado");
                sb.AppendLine($"Data;{DateTime.Now:yyyy-MM-dd HH:mm:ss}");
                sb.AppendLine($"VendaID;{vendaId}");
                sb.AppendLine($"FormaPagamento;{forma}");
                sb.AppendLine();
                sb.AppendLine("Codigo;Descricao;Quantidade;PrecoUnit;Subtotal");
                foreach (DataRow r in dtItens.Rows)
                {
                    string codigo = r.Field<string>("codigo");
                    string desc = r.Field<string>("descricao");
                    int qtd = r.Field<int>("quantidade");
                    decimal preco = r.Field<decimal>("preco_unitario");
                    decimal sub = r.Field<decimal>("subtotal");
                    sb.AppendLine($"{codigo};{desc};{qtd};{preco:N2};{sub:N2}");
                }
                sb.AppendLine();
                sb.AppendLine($"TOTAL;; ; ;{total:N2}");

                string fileName = Path.Combine(Path.GetTempPath(), $"venda_{vendaId}.csv");
                File.WriteAllText(fileName, sb.ToString(), Encoding.GetEncoding("iso-8859-1"));

                var psi = new ProcessStartInfo(fileName) { UseShellExecute = true };
                Process.Start(psi);
            }
            catch
            {
                // Não bloqueante
            }
        }

        private void btnVoltar_Click(object sender, EventArgs e)
        {
            foreach (Form f in Application.OpenForms)
            {
                if (f is Form1)
                {
                    f.Show();
                    this.Close();
                    return;
                }
            }

            new Form1().Show();
            this.Close();
        }
