using System;
using System.Data;
using System.Drawing;
using System.Windows.Forms;
using mercado.Data;

namespace mercado.Forms
{
    public class FormProduto : Form
    {
        private InventoryService service;
        private DataGridView dgv;
        private TextBox txtId, txtNome, txtDescricao, txtPreco, txtQuantidade;
        private Button btnSalvar, btnNovo, btnRefresh;

        public FormProduto()
        {
            this.Text = "Cadastro e Consulta de Produtos";
            this.Size = new Size(800, 600);

            service = new InventoryService();
            // Configure a connection string quando for conectar ao banco:
            // service.ConnectionString = "Server=localhost;Database=...;Uid=...;Pwd=...";

            InitializeComponents();
            Load += (s, e) => RefreshGrid();
        }

        private void InitializeComponents()
        {
            dgv = new DataGridView { Location = new Point(10, 200), Size = new Size(760, 350), ReadOnly = true, AllowUserToAddRows = false };

            Label lblId = new Label { Text = "Id", Location = new Point(10, 10), AutoSize = true };
            txtId = new TextBox { Location = new Point(80, 10), Width = 100, ReadOnly = true };

            Label lblNome = new Label { Text = "Nome", Location = new Point(10, 40), AutoSize = true };
            txtNome = new TextBox { Location = new Point(80, 40), Width = 300 };

            Label lblDescricao = new Label { Text = "Descricao", Location = new Point(10, 70), AutoSize = true };
            txtDescricao = new TextBox { Location = new Point(80, 70), Width = 300 };

            Label lblPreco = new Label { Text = "Preco", Location = new Point(400, 40), AutoSize = true };
            txtPreco = new TextBox { Location = new Point(470, 40), Width = 120 };

            Label lblQuantidade = new Label { Text = "Quantidade", Location = new Point(400, 70), AutoSize = true };
            txtQuantidade = new TextBox { Location = new Point(470, 70), Width = 120 };

            btnSalvar = new Button { Text = "Salvar/Atualizar", Location = new Point(80, 110) };
            btnSalvar.Click += BtnSalvar_Click;

            btnNovo = new Button { Text = "Novo", Location = new Point(220, 110) };
            btnNovo.Click += (s, e) => ClearForm();

            btnRefresh = new Button { Text = "Atualizar Lista", Location = new Point(360, 110) };
            btnRefresh.Click += (s, e) => RefreshGrid();

            this.Controls.AddRange(new Control[] { dgv, lblId, txtId, lblNome, txtNome, lblDescricao, txtDescricao, lblPreco, txtPreco, lblQuantidade, txtQuantidade, btnSalvar, btnNovo, btnRefresh });

            dgv.CellDoubleClick += Dgv_CellDoubleClick;
        }

        private void Dgv_CellDoubleClick(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0) return;
            var row = dgv.Rows[e.RowIndex];
            txtId.Text = row.Cells["id"].Value?.ToString();
            txtNome.Text = row.Cells["nome"].Value?.ToString();
            txtDescricao.Text = row.Cells["descricao"].Value?.ToString();
            txtPreco.Text = row.Cells["preco"].Value?.ToString();
            txtQuantidade.Text = row.Cells["quantidade"].Value?.ToString();
        }

        private void BtnSalvar_Click(object sender, EventArgs e)
        {
            int id = 0;
            int.TryParse(txtId.Text, out id);
            decimal preco = 0;
            decimal.TryParse(txtPreco.Text, out preco);
            int qtd = 0;
            int.TryParse(txtQuantidade.Text, out qtd);

            var p = new Product
            {
                Id = id,
                Nome = txtNome.Text.Trim(),
                Descricao = txtDescricao.Text.Trim(),
                Preco = preco,
                Quantidade = qtd
            };

            bool ok = service.AddOrUpdateProduct(p);
            if (ok)
            {
                MessageBox.Show("Produto salvo com sucesso.", "Sucesso", MessageBoxButtons.OK, MessageBoxIcon.Information);
                RefreshGrid();
                ClearForm();
            }
        }

        private void RefreshGrid()
        {
            DataTable dt = service.GetAllProducts();
            dgv.DataSource = dt;
        }

        private void ClearForm()
        {
            txtId.Text = "";
            txtNome.Text = "";
            txtDescricao.Text = "";
            txtPreco.Text = "";
            txtQuantidade.Text = "";
        }
    }
}
